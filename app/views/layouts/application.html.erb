<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Personal Portfolio Website Built With Ruby" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Personal Portfolio Website Built With Ruby">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
</head>

<body>
<header>
  <nav class="nav-buttons">
    <%= link_to "Головна", root_path, class: "btn" %>
    <%= link_to "Проекти", projects_path, class: "btn" %>
    <%= link_to "Навички", skills_path, class: "btn" %>
    <%= link_to "Контакти", contact_path, class: "btn" %>
  </nav>
</header>

<main>
  <%= yield %>
</main>
</body>
</html>
